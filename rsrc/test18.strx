# Testing if-else branching.

def main() -> void {
    cond1: bool;
    cond2: bool;
    res1: int;
    res2: int;

    if (cond1) {
        res1 = 0;
    } else {
        res1 = 1;
    }

    if (cond2) {
        res2 = 0;
    } else {
        res2 = 1;
    }

    printInt(res1);
    printInt(res2);
}